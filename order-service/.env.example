# Order Service Environment Configuration

# Server Port
PORT=3001

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/cakedelight-order

# Catalog Service Base URL (Used for validating items during basket/checkout)
CATALOG_SERVICE_URL=http://localhost:3000

# RabbitMQ Connection URL (For publishing order creation events)
RABBITMQ_URL=amqp://localhost:5672
