# Cake Delight - Root Environment Configuration Template
# Copy this file to .env or configure individual microservice .env files.

# Global / Shared Settings
JWT_SECRET=your-secure-jwt-secret-key-here
MONGODB_URI=mongodb://localhost:27017/cakedelight
RABBITMQ_URL=amqp://localhost:5672
SMTP_HOST=localhost

# Service Ports & Target URLs
GATEWAY_PORT=8080
CATALOG_PORT=3000
ORDER_PORT=3001
RATING_PORT=3002
NOTIFICATION_PORT=3003

CATALOG_SERVICE_URL=http://localhost:3000
ORDER_SERVICE_URL=http://localhost:3001
RATING_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3003
